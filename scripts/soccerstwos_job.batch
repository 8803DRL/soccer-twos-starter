#!/bin/bash

# Soccer Twos RL Training Job - PPO Self-Play with Reward Shaping
# PACE Cluster (ICE nodes, A40 GPU)

#SBATCH --job-name=soccertwos_mp
#SBATCH -N1 --ntasks-per-node=12
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#SBATCH -t04:00:00
#SBATCH --output=soccertwos_mp-%j.out
#SBATCH --error=soccertwos_mp-%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=zbguo@gatech.edu

module load cuda/12.6

# Activate conda — use eval hook which works without conda init
eval "$(conda shell.bash hook)" 2>/dev/null
conda activate /storage/ice1/1/4/zguo407/soccertwos 2>/dev/null

# Fallback: ensure the right python is on PATH
export PATH="/storage/ice1/1/4/zguo407/soccertwos/bin:$PATH"

cd $SLURM_SUBMIT_DIR/..

echo "=== Job started at $(date) ==="
echo "=== Node: $(hostname) ==="
echo "=== Python: $(which python) ==="
echo "=== GPU Info ==="
nvidia-smi

# Kill any leftover Unity processes from previous runs
pkill -f SoccerTwos 2>/dev/null || true
sleep 2

# Run training (stderr goes to .err file via SBATCH --error)
python train_selfplay_shaped.py

echo "=== Job finished at $(date) ==="
